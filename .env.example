# Copia los valores del ambiente que quieras ejecutar en tu configuracion local.
# Spring Boot no carga este archivo automaticamente.

# DEV
PROFILE_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/empleados_dev?useSSL=false&serverTimezone=America/Lima
DB_USER=root
DB_PASSWORD=
SERVER_PORT=8080

# Para QA cambia PROFILE_ACTIVE a qa, la base a empleados_qa y SERVER_PORT a 8082.
# Para TEST cambia PROFILE_ACTIVE a test, la base a empleados_test y SERVER_PORT a 8084.
# Para PROD cambia PROFILE_ACTIVE a prod, la base a empleados_prod y SERVER_PORT a 8086.
# Define DB_PASSWORD con la contraseña local que corresponda; no guardes credenciales reales aquí.
