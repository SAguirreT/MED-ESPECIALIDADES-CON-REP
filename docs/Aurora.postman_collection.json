{
  "info": {
    "name": "Aurora · JWT, agenda y auditoría",
    "description": "Ejecutar en orden con la base de demostración. Los casos de reserva crean y cancelan una cita ficticia. Ajustar baseUrl al puerto activo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "altered.invalid.signature"
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "medicoId",
      "value": ""
    },
    {
      "key": "especialidadId",
      "value": ""
    },
    {
      "key": "pacienteId",
      "value": ""
    },
    {
      "key": "horarioId",
      "value": ""
    },
    {
      "key": "hora",
      "value": ""
    },
    {
      "key": "citaId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"fecha\")) pm.collectionVariables.set(\"fecha\", new Date(Date.now()+3*86400000).toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 · Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/signin",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@aurora.demo\",\n  \"password\": \"AuroraAdmin2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Login USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/signin",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"consulta@aurora.demo\",\n  \"password\": \"AuroraConsulta2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"userToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Caso 1 · Pública",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/test/all"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Caso 2 · Sin token",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/test/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Caso 3 · Token alterado",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{invalidToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/test/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Caso 4 · Token USER válido",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/test/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Caso 5 · USER intenta ADMIN",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/test/admin"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Caso 6 · ADMIN autorizado",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/test/admin"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Catálogo · Médicos",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/medicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const m=pm.response.json().find(m=>m.estado && m.especialidades.length); if(m){pm.collectionVariables.set(\"medicoId\",m.id);pm.collectionVariables.set(\"especialidadId\",m.especialidades[0].id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Catálogo · Pacientes",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/pacientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const p=pm.response.json().find(p=>p.estado); if(p)pm.collectionVariables.set(\"pacienteId\",p.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Disponibilidad · Seleccionar un cupo futuro",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/disponibilidad/medico/{{medicoId}}?fecha={{fecha}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const slot=pm.response.json().find(s=>s.disponible); pm.test(\"Hay un cupo libre\",()=>pm.expect(slot).to.exist); if(slot){pm.collectionVariables.set(\"horarioId\",slot.horarioId);pm.collectionVariables.set(\"hora\",slot.horaInicio);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Cita · Reservar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/citas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"especialidadId\": {{especialidadId}},\n  \"horarioId\": {{horarioId}},\n  \"fecha\": \"{{fecha}}\",\n  \"horaInicio\": \"{{hora}}\",\n  \"motivo\": \"Prueba académica ficticia\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"citaId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Cita · Rechazar el mismo cupo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/citas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"medicoId\": {{medicoId}},\n  \"especialidadId\": {{especialidadId}},\n  \"horarioId\": {{horarioId}},\n  \"fecha\": \"{{fecha}}\",\n  \"horaInicio\": \"{{hora}}\",\n  \"motivo\": \"Intento duplicado de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cita · Cancelar y liberar",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/citas/{{citaId}}/cancelar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"motivo\": \"Fin de la demostración\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auditoría · Revisar los cambios",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/auditoria?page=0&size=10&tabla=citas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reporte · Médicos por especialidad",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/reportes/medicos-por-especialidad"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuarios · No exponer hashes",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sin contraseñas\",()=>pm.response.json().forEach(u=>pm.expect(u).not.to.have.property(\"password\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cerrar sesiones USER",
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/auth/signout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Token revocado · Rechazado",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/test/user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
